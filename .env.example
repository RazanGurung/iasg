DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQL Server. On the app server this is a local connection.
DB_NAME=IASG_MIS
DB_HOST=localhost
DB_PORT=1433
DB_USER=iasgmis_app
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERT=yes

# Field encryption key. MUST NOT live in the database or in git.
FIELD_ENCRYPTION_KEY=
CREDENTIAL_VAULT_KEY=

# Windows only, optional: semicolon-separated dirs holding WeasyPrint's
# native GTK/Pango/Cairo DLLs, e.g. a conda-forge "pango" env's Library\bin.
# Leave blank on Linux, or if using the standalone GTK3 runtime installed at
# its default path (C:\Program Files\GTK3-Runtime Win64\bin — WeasyPrint
# checks that location automatically).
WEASYPRINT_DLL_DIRECTORIES=
